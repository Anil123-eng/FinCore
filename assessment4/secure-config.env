# FinCore Secure Deployment Configuration
# ========================================

# Environment separation
NODE_ENV=development
FASTAPI_ENV=development
DOTNET_ENV=development

# Database security
POSTGRES_PRIVILEGED_USER=fincore
POSTGRES_READONLY_USER=fincore_readonly
POSTGRES_DB=fincore
POSTGRES_CONNECTION_MAX=20
POSTGRES_CONNECTION_IDLE_TIMEOUT=30000

# Security headers (Helmet configuration)
HELMET_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_MESSAGE="Too many requests, please try again later."

# Security configuration
CORS_ORIGIN_WHITELIST=http://localhost:3000,http://localhost:3001
CORS_SUPPORTS_CREDENTIALS=false

# HTTPS configuration
FORWARDED_PROTO=X-Forwarded-Proto
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
PRELOAD_HSTS=true

# Audit and logging
LOG_CORRELATION_ID=true
LOG_SENSITIVE_DATA=false
LOG_MAX_FIELDS=100
'''