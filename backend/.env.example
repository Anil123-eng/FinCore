# FinCore Backend Environment Variables
PORT=3001
NODE_ENV=development

# PostgreSQL connection (dedicated FinCore database)
# Option A: single connection string
DATABASE_URL=postgresql://fincore:password@localhost:5433/fincore
# Option B: discrete parts (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5433
PGUSER=fincore
PGPASSWORD=password
PGDATABASE=fincore
PGPOOL_MAX=10